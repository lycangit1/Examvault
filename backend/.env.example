# ExamVault Hardened Backend Environment Configuration Template

# Server Configuration
PORT=8000
ENVIRONMENT=production

# Database URL (SQLAlchemy ORM connection)
DATABASE_URL=sqlite:///./examvault_hardened.db

# JWT Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=examvault_super_secret_cryptographic_jwt_signing_key_32bytes_min_length_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-Level Symmetric Encryption Key (Fernet / AES-128-CBC + HMAC-SHA256)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS1mb3ItZmVybmV0PQ==

# Security Thresholds
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_LOCKOUT_MINUTES=5
SESSION_IDLE_TIMEOUT_MINUTES=15
MAX_UPLOAD_SIZE_BYTES=10485760
